# Cloudflare Pages 캐시 정책
# 확인: Security Analytics 기준 캐시 히트율 9% (origin 459 / CF 47)

# Vite가 콘텐츠 해시를 붙이는 번들 — 내용이 바뀌면 파일명이 바뀌므로 영구 캐시 안전
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 스크린샷: 경로가 고정이라 immutable은 쓰지 않음.
# 같은 파일명으로 이미지를 교체할 수 있으므로 30일 후 재검증.
/media/*
  Cache-Control: public, max-age=2592000

/cat.png
  Cache-Control: public, max-age=2592000
/dangseon.png
  Cache-Control: public, max-age=2592000
/seobuds.png
  Cache-Control: public, max-age=2592000

# HTML은 캐시하지 않음 — 배포가 즉시 반영돼야 함
/index.html
  Cache-Control: public, max-age=0, must-revalidate
